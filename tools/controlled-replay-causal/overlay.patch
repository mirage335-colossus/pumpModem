+    std::atomic<bool> storage_failed{false};
+    bool finalized=false,metadata_open_failed=false;
+    std::atomic<bool> observer_clock_failed{false};
+    bool pcm_flush_ok=false,pcm_close_ok=false,metadata_flush_ok=false,metadata_close_ok=false,metadata_write_failed=false;
+
+    State() noexcept {
+        if(enabled()) {
+            partitions.reset(new(std::nothrow) Partition[partition_limit]);
+            if(!partitions) storage_failed.store(true,std::memory_order_relaxed);
+        }
+    }
+    ~State() { finalize(); }
+
+    void add_observer_cost(std::chrono::steady_clock::time_point wall_start,
+                           std::clock_t cpu_start) noexcept {
+        const auto wall_end=std::chrono::steady_clock::now();
+        const auto cpu_end=std::clock();
+        const auto ns=std::chrono::duration_cast<std::chrono::nanoseconds>(wall_end-wall_start).count();
+        if(ns>=0 && static_cast<std::uint64_t>(ns)<=no_slot-observer_wall_ns)
+            observer_wall_ns+=static_cast<std::uint64_t>(ns);
+        else observer_clock_failed.store(true,std::memory_order_relaxed);
+        if(cpu_start!=static_cast<std::clock_t>(-1)&&cpu_end!=static_cast<std::clock_t>(-1)&&cpu_end>=cpu_start) {
+            const auto ticks=static_cast<std::uint64_t>(cpu_end-cpu_start);
+            if(ticks<=no_slot-observer_process_cpu_ticks) observer_process_cpu_ticks+=ticks;
+            else observer_clock_failed.store(true,std::memory_order_relaxed);
+        } else observer_clock_failed.store(true,std::memory_order_relaxed);
+    }
+
+    void open_pcm() noexcept {
+        if(path_checked)return;
+        path_checked=true;
+        try {
+            const auto* env=std::getenv("DATAPUMP_CAUSAL_PCM");
+            if(!env||!*env||std::strlen(env)>4096||sizeof(float)!=4||
+               std::endian::native!=std::endian::little||!std::numeric_limits<float>::is_iec559) {
+                pcm_open_failed=true; ++io_errors; return;
+            }
+            pcm_path=env;
+            if(pcm_path.empty()||pcm_path.front()!='/'||pcm_path.find('\0')!=std::string::npos) {
+                pcm_open_failed=true; ++io_errors; return;
+            }
+            path_valid=true;
+            pcm=std::fopen(pcm_path.c_str(),"wbx");
+            if(!pcm) { pcm_open_failed=true; ++io_errors; }
+        } catch(...) { pcm_open_failed=true; ++io_errors; }
+    }
+
+    void capture(const void* owner,std::uint64_t revision,const std::uint64_t& frontier,
+                 std::span<const float> samples,std::uint64_t tx_serial,
+                 std::uint64_t& slot) noexcept {
+        const auto wall_start=std::chrono::steady_clock::now();
+        const auto cpu_start=std::clock();
+        try {
+            std::lock_guard lock(mutex);
+            if(finalized)return;
+            open_pcm();
+            if(samples.size()>std::numeric_limits<std::uint64_t>::max()-attempted_samples) { attempted_samples=no_slot;counter_overflow=true; }
+            else attempted_samples+=samples.size();
+            if(total_partitions<std::numeric_limits<std::uint64_t>::max())++total_partitions;else counter_overflow=true;
+            slot=no_slot;
+            if(partition_count<partition_limit&&partitions) {
+                slot=partition_count++;
+                auto& part=partitions[slot];
+                part.owner_cookie=static_cast<std::uint64_t>(reinterpret_cast<std::uintptr_t>(owner));
+                part.revision=revision; part.tx_serial=tx_serial;
+                part.frontier_before=frontier; part.input_count=samples.size();
+                part.file_sample_offset=captured_samples;
+            } else partition_limited=true;
+            const auto remaining=captured_samples<pcm_limit_bytes/sizeof(float)
+                ?pcm_limit_bytes/sizeof(float)-captured_samples:0;
+            const auto count=static_cast<std::size_t>(std::min<std::uint64_t>(remaining,samples.size()));
+            if(count<samples.size())pcm_limited=true;
+            if(pcm&&count) {
+                const auto written=std::fwrite(samples.data(),sizeof(float),count,pcm);
+                captured_samples+=written;
+                if(slot!=no_slot)partitions[slot].captured_count=written;
+                if(written!=count) {++io_errors;pcm_write_failed=true;}
+            }
+        } catch(...) {
+            try { std::lock_guard lock(mutex); storage_failed.store(true,std::memory_order_relaxed); } catch(...) {}
+        }
+        try { std::lock_guard lock(mutex); add_observer_cost(wall_start,cpu_start); }
+        catch(...) { observer_clock_failed.store(true,std::memory_order_relaxed); }
+    }
+
+    void finish_feed(std::uint64_t slot,const std::uint64_t& frontier,bool exception) noexcept {
+        const auto wall_start=std::chrono::steady_clock::now();
+        const auto cpu_start=std::clock();
+        try {
+            std::lock_guard lock(mutex);
+            if(!finalized&&slot<partition_count&&partitions) {
+                auto& part=partitions[slot];
+                part.frontier_after=frontier;part.exception=exception;
+            } else if(!finalized)storage_failed.store(true,std::memory_order_relaxed);
+            add_observer_cost(wall_start,cpu_start);
+        } catch(...) { storage_failed.store(true,std::memory_order_relaxed);observer_clock_failed.store(true,std::memory_order_relaxed); }
+    }
+
+    void finalize() noexcept {
+        if(!enabled())return;
+        try {
+            std::lock_guard lock(mutex);
+            if(finalized)return;
+            finalized=true;
+            if(pcm) {
+                pcm_flush_ok=std::fflush(pcm)==0;
+                auto* closing=std::exchange(pcm,nullptr);
+                pcm_close_ok=std::fclose(closing)==0;
+                if(!pcm_flush_ok||!pcm_close_ok)++io_errors;
+            }
+            if(path_valid) {
+                std::string metadata_path=pcm_path+".json";
+                auto* file=std::fopen(metadata_path.c_str(),"wx");
+                if(!file) { metadata_open_failed=true; ++io_errors; }
+                else {
+                    bool failed=false;
+                    auto write=[&](const char* format,auto... args) {
+                        if(std::fprintf(file,format,args...)<0)failed=true;
+                    };
+                    write("{\"schema\":1,\"format\":\"IEEE754 binary32 little endian\",\"frontier_semantics\":\"before/after equality is a bounded joined frontier observation, not proof that every RX sample was fully scored\",\"pcm_path\":%s,\"pcm_bytes\":%llu,\"captured_samples\":%llu,\"attempted_samples\":%llu,\"pcm_limit_bytes\":%llu,\"partition_limit\":%llu,\"partitions\":[",
+                        quote(pcm_path).c_str(),static_cast<unsigned long long>(captured_samples*sizeof(float)),
+                        static_cast<unsigned long long>(captured_samples),static_cast<unsigned long long>(attempted_samples),
+                        static_cast<unsigned long long>(pcm_limit_bytes),static_cast<unsigned long long>(partition_limit));
+                    for(std::size_t i=0;i<partition_count&&partitions;++i) {
+                        const auto& p=partitions[i];
+                        write("%s{\"owner_cookie\":%llu,\"revision\":%llu,\"tx_serial\":%llu,\"frontier_before\":%llu,\"frontier_after\":%llu,\"input_count\":%llu,\"file_sample_offset\":%llu,\"captured_count\":%llu,\"exception\":%s}",
+                            i?",":"",static_cast<unsigned long long>(p.owner_cookie),
+                            static_cast<unsigned long long>(p.revision),static_cast<unsigned long long>(p.tx_serial),
+                            static_cast<unsigned long long>(p.frontier_before),static_cast<unsigned long long>(p.frontier_after),
+                            static_cast<unsigned long long>(p.input_count),static_cast<unsigned long long>(p.file_sample_offset),
+                            static_cast<unsigned long long>(p.captured_count),p.exception?"true":"false");
+                    }
+                    write("],\"partitions_recorded\":%llu,\"total_partitions\":%llu,\"partition_limited\":%s,\"pcm_limited\":%s,\"open_failed\":%s,\"write_failed\":%s,\"storage_failed\":%s,\"counter_overflow\":%s,\"io_errors_before_finalize\":%llu,\"pcm_flush_ok\":%s,\"pcm_close_ok\":%s,\"observer_wall_ns\":%llu,\"observer_wall_scope\":\"sum of per-feed entry PCM capture and exit metadata work; excludes receiver execution and finalization\",\"observer_process_cpu_ticks\":%llu,\"observer_process_cpu_ticks_per_second\":%llu,\"observer_process_cpu_scope\":\"std::clock process CPU across threads, measured only around per-feed entry/exit instrumentation\",\"observer_clock_failed\":%s}\n",
+                        static_cast<unsigned long long>(partition_count),static_cast<unsigned long long>(total_partitions),
+                        partition_limited?"true":"false",pcm_limited?"true":"false",pcm_open_failed?"true":"false",
+                        pcm_write_failed?"true":"false",storage_failed.load(std::memory_order_relaxed)?"true":"false",counter_overflow?"true":"false",static_cast<unsigned long long>(io_errors),
+                        pcm_flush_ok?"true":"false",pcm_close_ok?"true":"false",
+                        static_cast<unsigned long long>(observer_wall_ns),static_cast<unsigned long long>(observer_process_cpu_ticks),
+                        static_cast<unsigned long long>(CLOCKS_PER_SEC),observer_clock_failed.load(std::memory_order_relaxed)?"true":"false");
+                    metadata_flush_ok=std::fflush(file)==0;
+                    metadata_close_ok=std::fclose(file)==0;
+                    metadata_write_failed=failed;
+                    if(failed||!metadata_flush_ok||!metadata_close_ok)++io_errors;
+                }
+            }
+            std::fprintf(stderr,
+                "{\"event\":\"datapump_causal_input_seal\",\"schema\":1,\"pcm_path\":%s,\"metadata_path\":%s,\"captured_samples\":%llu,\"partitions\":%llu,\"pcm_limited\":%s,\"partition_limited\":%s,\"open_failed\":%s,\"metadata_open_failed\":%s,\"metadata_write_failed\":%s,\"storage_failed\":%s,\"counter_overflow\":%s,\"io_errors\":%llu,\"pcm_flush_ok\":%s,\"pcm_close_ok\":%s,\"metadata_flush_ok\":%s,\"metadata_close_ok\":%s,\"complete\":%s,\"observer_wall_ns\":%llu,\"observer_process_cpu_ticks\":%llu,\"observer_process_cpu_ticks_per_second\":%llu}\n",
+                quote(pcm_path).c_str(),quote(path_valid?pcm_path+".json":std::string{}).c_str(),
+                static_cast<unsigned long long>(captured_samples),static_cast<unsigned long long>(total_partitions),
+                pcm_limited?"true":"false",partition_limited?"true":"false",pcm_open_failed?"true":"false",
+                metadata_open_failed?"true":"false",metadata_write_failed?"true":"false",storage_failed.load(std::memory_order_relaxed)?"true":"false",counter_overflow?"true":"false",static_cast<unsigned long long>(io_errors),
+                pcm_flush_ok?"true":"false",pcm_close_ok?"true":"false",metadata_flush_ok?"true":"false",
+                metadata_close_ok?"true":"false",(path_valid&&pcm_flush_ok&&pcm_close_ok&&!pcm_open_failed&&!pcm_write_failed&&!pcm_limited&&!partition_limited&&!storage_failed.load(std::memory_order_relaxed)&&!counter_overflow&&!metadata_open_failed&&!metadata_write_failed&&metadata_flush_ok&&metadata_close_ok)?"true":"false",static_cast<unsigned long long>(observer_wall_ns),
+                static_cast<unsigned long long>(observer_process_cpu_ticks),static_cast<unsigned long long>(CLOCKS_PER_SEC));
+            std::fflush(stderr);
+        } catch(...) {
+            std::fputs("{\"event\":\"datapump_causal_input_seal\",\"schema\":1,\"finalization_exception\":true}\n",stderr);
+            std::fflush(stderr);
+        }
+    }
+};
+
+inline State& state() noexcept {
+    static State value;
+    return value;
+}
+
+class Feed {
+    const std::uint64_t& frontier_;
+    std::uint64_t slot_=no_slot;
+    int uncaught_=0;
+public:
+    Feed(const void* owner,std::uint64_t revision,const std::uint64_t& bank_frontier,
+         std::span<const float> samples,std::uint64_t tx_serial) noexcept
+        :frontier_(bank_frontier),uncaught_(std::uncaught_exceptions()) {
+        if(enabled())state().capture(owner,revision,bank_frontier,samples,tx_serial,slot_);
+    }
+    ~Feed() {
+        if(enabled())state().finish_feed(slot_,frontier_,std::uncaught_exceptions()>uncaught_);
+    }
+    Feed(const Feed&)=delete;
+    Feed& operator=(const Feed&)=delete;
+};
+} // namespace datapump::diagnostic::causal_input
