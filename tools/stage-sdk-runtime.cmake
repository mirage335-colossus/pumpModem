cmake_minimum_required(VERSION 3.21)
foreach(variable SDK_SYSROOT OBJDUMP EXECUTABLE DESTINATION)
  if(NOT DEFINED ${variable} OR "${${variable}}" STREQUAL "")
    message(FATAL_ERROR "SDK runtime staging requires ${variable}")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/SdkRuntime.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/RuntimePolicy.cmake")
file(REAL_PATH "${SDK_SYSROOT}" SDK_SYSROOT)

list(LENGTH PROJECT_LIBRARIES library_count)
list(LENGTH PROJECT_SONAMES soname_count)
if(NOT library_count EQUAL soname_count)
  message(FATAL_ERROR "Project shared-library files and SONAMEs must match")
endif()
foreach(library IN LISTS PROJECT_LIBRARIES)
  if(NOT IS_DIRECTORY "${BUILD_ROOT}")
    message(FATAL_ERROR "Explicit project runtime libraries require BUILD_ROOT")
  endif()
  datapump_sdk_validate_path("${library}" "${BUILD_ROOT}")
endforeach()
foreach(name IN LISTS PROJECT_SONAMES)
  if(NOT name MATCHES "^[A-Za-z0-9_+.-]+$" OR name STREQUAL "." OR name STREQUAL "..")
    message(FATAL_ERROR "Invalid project shared-library SONAME: ${name}")
  endif()
  string(REPLACE "." "\\." pattern "${name}")
  string(REPLACE "+" "\\+" pattern "${pattern}")
  list(APPEND DATAPUMP_OS_LIBRARIES "^${pattern}$")
endforeach()

# Live audio loads ALSA by name, so it is not visible in ELF DT_NEEDED entries.
set(alsa "")
if(NOT "libasound.so.2" IN_LIST PROJECT_SONAMES)
  datapump_sdk_find_library("libasound.so.2" "${SDK_SYSROOT}" alsa)
endif()
datapump_sdk_runtime_dependencies(resolved SYSROOT "${SDK_SYSROOT}" OBJDUMP "${OBJDUMP}"
  EXECUTABLES "${EXECUTABLE}" ${PROJECT_LIBRARIES} LIBRARIES ${alsa} EXCLUDE_REGEXES ${DATAPUMP_OS_LIBRARIES})

file(MAKE_DIRECTORY "${DESTINATION}")
# Multiple test executables may finish linking together and share this cache.
file(LOCK "${DESTINATION}/.lock" GUARD PROCESS TIMEOUT 120)
foreach(source IN LISTS resolved)
  datapump_sdk_validate_path("${source}" "${SDK_SYSROOT}")
  file(REAL_PATH "${source}" real_source)
  file(SHA256 "${real_source}" incoming)
  set(current "${source}")
  set(visited)
  while(TRUE)
    if(current IN_LIST visited)
      message(FATAL_ERROR "Cyclic SDK library link: ${source}")
    endif()
    list(APPEND visited "${current}")
    get_filename_component(name "${current}" NAME)
    set(destination "${DESTINATION}/${name}")
    set(stamp "${DESTINATION}/.${name}.sha256")
    set(previous "")
    if(EXISTS "${stamp}" AND EXISTS "${destination}")
      file(READ "${stamp}" previous)
    endif()
    if(NOT previous STREQUAL incoming)
      # Materialize the SONAME and every alias: never retain SDK-pointing links.
      file(COPY_FILE "${real_source}" "${destination}" ONLY_IF_DIFFERENT)
      file(RPATH_REMOVE FILE "${destination}")
      file(WRITE "${stamp}" "${incoming}")
    endif()
    if(NOT IS_SYMLINK "${current}")
      break()
    endif()
    file(READ_SYMLINK "${current}" following)
    if(IS_ABSOLUTE "${following}")
      set(current "${following}")
    else()
      get_filename_component(parent "${current}" DIRECTORY)
      set(current "${parent}/${following}")
    endif()
  endwhile()
endforeach()
