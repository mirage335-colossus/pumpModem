# Standalone opt-in lab targets, injected into the normal source-root CMake
# configure via -DCMAKE_PROJECT_DataPump_INCLUDE=.../inject.cmake. No installed
# application target links these lab providers.
function(datapump_add_lab_audio_targets)
  if(NOT TARGET datapump_web_bridge OR NOT TARGET datapump_audio_native)
    message(FATAL_ERROR "Lab audio requires a native build with DATAPUMP_BUILD_WEB_WORKER=ON")
  endif()
  set(lab "${CMAKE_SOURCE_DIR}/_zLab/audio")
  add_executable(datapump-lab-worker "${lab}/worker.cpp" "${lab}/remote.cpp" "${lab}/provider.cpp"
    "${CMAKE_SOURCE_DIR}/src/audio_entropy.cpp" "${CMAKE_SOURCE_DIR}/src/host/protocol.cpp" "${CMAKE_SOURCE_DIR}/src/host/runtime.cpp" "${CMAKE_SOURCE_DIR}/src/host/sandbox.cpp")
  target_include_directories(datapump-lab-worker PRIVATE "${CMAKE_SOURCE_DIR}/include" "${CMAKE_SOURCE_DIR}/src/host" "${lab}")
  target_link_libraries(datapump-lab-worker PRIVATE datapump_web_bridge datapump)
  if(EXISTS "${lab}/test_remote.cpp")
    add_executable(datapump-lab-audio-test "${lab}/test_remote.cpp" "${lab}/remote.cpp" "${lab}/provider.cpp" "${CMAKE_SOURCE_DIR}/src/host/protocol.cpp")
    target_include_directories(datapump-lab-audio-test PRIVATE "${CMAKE_SOURCE_DIR}/include" "${lab}")
    target_link_libraries(datapump-lab-audio-test PRIVATE datapump Threads::Threads)
  endif()
  if(EXISTS "${lab}/local_main.cpp")
    add_executable(datapump-lab-audio "${lab}/local.cpp" "${lab}/local_native.cpp" "${lab}/local_main.cpp" "${CMAKE_SOURCE_DIR}/src/host/protocol.cpp")
    target_include_directories(datapump-lab-audio PRIVATE "${CMAKE_SOURCE_DIR}/include" "${lab}")
    target_link_libraries(datapump-lab-audio PRIVATE datapump_audio_native datapump ${CMAKE_DL_LIBS} Threads::Threads)
  endif()
  if(EXISTS "${lab}/local_test.cpp")
    add_executable(datapump-lab-local-test "${lab}/local.cpp" "${lab}/local_test.cpp" "${CMAKE_SOURCE_DIR}/src/host/protocol.cpp")
    target_include_directories(datapump-lab-local-test PRIVATE "${CMAKE_SOURCE_DIR}/include" "${lab}")
    target_link_libraries(datapump-lab-local-test PRIVATE Threads::Threads)
  endif()
endfunction()
cmake_language(DEFER CALL datapump_add_lab_audio_targets)
