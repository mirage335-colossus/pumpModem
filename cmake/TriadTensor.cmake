option(DATAPUMP_TRIAD_TENSOR "Build the optional native ATen receiver backend" OFF)
option(DATAPUMP_TRIAD_TENSOR_REQUIRE_CUDA "Require CUDA-capable ATen and register the CUDA receiver check" OFF)

if(DATAPUMP_TRIAD_TENSOR_REQUIRE_CUDA AND NOT DATAPUMP_TRIAD_TENSOR)
  message(FATAL_ERROR "DATAPUMP_TRIAD_TENSOR_REQUIRE_CUDA requires DATAPUMP_TRIAD_TENSOR")
endif()
if(NOT DATAPUMP_TRIAD_TENSOR)
  return()
endif()
if(DATAPUMP_BUILD_WASM)
  message(FATAL_ERROR "The ATen receiver backend requires a native build")
endif()

find_package(Torch CONFIG REQUIRED)
separate_arguments(_triad_torch_flags NATIVE_COMMAND "${TORCH_CXX_FLAGS}")
if(TORCH_CXX_FLAGS MATCHES "_GLIBCXX_USE_CXX11_ABI=0")
  message(FATAL_ERROR "Use the C++11 ABI build of LibTorch with the native Robust receiver")
endif()

add_library(datapump_triad_tensor STATIC src/triad_tensor_backend.cpp)
target_include_directories(datapump_triad_tensor PUBLIC include PRIVATE src)
target_compile_features(datapump_triad_tensor PUBLIC cxx_std_20)
target_compile_options(datapump_triad_tensor PRIVATE ${_triad_torch_flags})
target_link_libraries(datapump_triad_tensor PRIVATE ${TORCH_LIBRARIES})
target_link_libraries(datapump_triad_receiver PRIVATE datapump_triad_tensor)
target_compile_definitions(datapump_triad_receiver PUBLIC DATAPUMP_HAVE_TRIAD_TENSOR=1)

if(CAFFE2_USE_CUDA AND NOT CAFFE2_USE_ROCM)
  find_package(CUDAToolkit REQUIRED)
  enable_language(CUDA)
  target_sources(datapump_triad_tensor PRIVATE src/triad_tensor_mapping.cu)
  set_target_properties(datapump_triad_tensor PROPERTIES CUDA_STANDARD 17 CUDA_STANDARD_REQUIRED ON)
  if(CMAKE_CUDA_COMPILER_ID STREQUAL "NVIDIA")
    foreach(_cuda_flags CMAKE_CUDA_FLAGS CMAKE_CUDA_FLAGS_DEBUG CMAKE_CUDA_FLAGS_RELEASE
                         CMAKE_CUDA_FLAGS_RELWITHDEBINFO CMAKE_CUDA_FLAGS_MINSIZEREL)
      if("${${_cuda_flags}}" MATCHES "(^|[ \t;])--?use_fast_math($|[= \t;])")
        message(FATAL_ERROR "Robust fused mapping requires CUDA math without --use_fast_math")
      endif()
    endforeach()
    set_source_files_properties(src/triad_tensor_mapping.cu PROPERTIES
      COMPILE_OPTIONS "--fmad=false;--ftz=false;--prec-div=true;--prec-sqrt=true")
  elseif(CMAKE_CUDA_COMPILER_ID STREQUAL "Clang")
    set_source_files_properties(src/triad_tensor_mapping.cu PROPERTIES
      COMPILE_OPTIONS "-fno-fast-math;-ffp-contract=off")
  else()
    message(FATAL_ERROR "The fused Robust mapping kernel requires NVIDIA or Clang CUDA compilation")
  endif()
  target_compile_definitions(datapump_triad_tensor PRIVATE DATAPUMP_TRIAD_TENSOR_CUDA=1)
  target_link_libraries(datapump_triad_tensor PRIVATE CUDA::cudart)
elseif(DATAPUMP_TRIAD_TENSOR_REQUIRE_CUDA)
  message(FATAL_ERROR "A CUDA-enabled LibTorch build is required for the Robust CUDA check")
else()
  target_compile_definitions(datapump_triad_tensor PRIVATE DATAPUMP_TRIAD_TENSOR_CUDA=0)
endif()

if(BUILD_TESTING OR DATAPUMP_TRIAD_TENSOR_REQUIRE_CUDA)
  if(BUILD_TESTING)
    add_executable(test_triad_tensor tests/test_triad_tensor.cpp)
  else()
    add_executable(test_triad_tensor EXCLUDE_FROM_ALL tests/test_triad_tensor.cpp)
  endif()
  target_include_directories(test_triad_tensor PRIVATE src)
  target_link_libraries(test_triad_tensor PRIVATE datapump_triad_receiver)
  if(CAFFE2_USE_CUDA AND NOT CAFFE2_USE_ROCM)
    target_compile_definitions(test_triad_tensor PRIVATE DATAPUMP_TRIAD_TENSOR_CUDA=1)
    target_compile_options(test_triad_tensor PRIVATE ${_triad_torch_flags})
    target_link_libraries(test_triad_tensor PRIVATE ${TORCH_LIBRARIES} CUDA::cudart)
  endif()
  if(BUILD_TESTING)
    add_test(NAME triad_tensor COMMAND test_triad_tensor)
    set_tests_properties(triad_tensor PROPERTIES LABELS "triad" TIMEOUT 30)
  endif()
  if(DATAPUMP_TRIAD_TENSOR_REQUIRE_CUDA)
    add_custom_target(test_triad_tensor_cuda DEPENDS test_triad_tensor)
    if(BUILD_TESTING)
      add_test(NAME triad_tensor_cuda COMMAND test_triad_tensor --cuda)
      set_tests_properties(triad_tensor_cuda PROPERTIES LABELS "triad;triad_gpu" TIMEOUT 30 RUN_SERIAL TRUE)
    endif()
  endif()
endif()
