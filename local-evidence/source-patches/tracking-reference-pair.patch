+        // template_value, while sharing PatternCode's exact two-bit traversal
+        // for uncached reference construction.
+        const bool cached=clock_ratio(f)==1 && !scoring.empty() && !scoring.front().nominal_reference.empty();
+        std::array<Complex,2> values;
+        if(cached) {
+            values={scoring.front().nominal_reference[bin][0],scoring.front().nominal_reference[bin][1]};
+        } else if(shaped) {
+            values=pattern.shaped_values(index*code.chips_per_symbol(),static_cast<double>(source_position));
+        } else {
+            values=pattern.values(chip,fraction);
+        }
+        const auto carrier=std::polar(1.,tau*search.frequency_offsets_hz[f]*static_cast<double>(sample_position)/config.sample_rate);
